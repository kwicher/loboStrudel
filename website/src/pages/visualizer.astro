---
// Bare, standalone page for the Grid's 3D visualizer -- no site header,
// sidebar, or REPL chrome, since this is loaded by Tauri as its own native
// window (see openVisualizerWindow() in src/repl/gridVisualizer.mjs), not
// navigated to as a normal site page. GridVisualizer3D owns the whole
// viewport and talks to the main window purely over Tauri's event bus.
import GridVisualizer3D from '../components/GridVisualizer3D.jsx';
---

<html dir="ltr" lang="en" class="initial dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Strudel Grid Visualizer</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: #05070a;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <GridVisualizer3D client:only="react" />
  </body>
</html>
